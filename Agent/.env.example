# Google AI Studio API Key (Supports Gemini 2.5/3.8 Flash with native Vision & Audio)
GOOGLE_API_KEY=your_google_api_key_here
GEMMA_MODEL=google/gemma-4-26b-a4b-it

# Cloud Neon PostgreSQL Connection URL
DATABASE_URL=postgresql://neondb_owner:password@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require
POSTGRES_URI=postgresql://neondb_owner:password@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require

# LangSmith Observability & Tracing
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=QuoteFlow-AI
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=QuoteFlow-AI
