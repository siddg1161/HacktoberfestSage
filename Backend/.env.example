# Python / LangGraph Agent API URL (hosted on Render or elsewhere)
AGENT_API_URL=https://quoteflow-agent.onrender.com

# Customer portal base URL for quotes/invoices
CLIENT_PORTAL_BASE_URL=https://your-frontend.vercel.app/portal

